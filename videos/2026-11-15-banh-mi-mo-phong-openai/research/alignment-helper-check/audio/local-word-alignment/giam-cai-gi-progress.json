{
  "requestHash": "38039d51b1047397c8bd70779f50446f472fa00dd67400f5341e0444a630a192",
  "segments": [
    {
      "start": 0.0,
      "end": 2.92,
      "text": " Hãy giữ đúng chiếc bánh ấy cùng lượng nhân và kích cỡ."
    },
    {
      "start": 3.78,
      "end": 6.42,
      "text": " Từ 20 lên 22,000 là tăng 10%."
    },
    {
      "start": 7.3000000000000025,
      "end": 10.76,
      "text": " Nếu kỳ sau chỉ tăng 2%, bánh không trở lại 20,000."
    },
    {
      "start": 11.6,
      "end": 14.46,
      "text": " Nó thành 22,440 đồng trong phép tính."
    },
    {
      "start": 15.34,
      "end": 16.92,
      "text": " Tỷ lệ đã hạ từ 10 xuống 2."
    },
    {
      "start": 17.84,
      "end": 19.14,
      "text": " Số tiền phải trả vẫn tăng."
    },
    {
      "start": 20.12,
      "end": 22.24,
      "text": " Đây là chỗ lời nói và kì vọng dễ đi lệt nhau."
    },
    {
      "start": 22.6,
      "end": 25.82,
      "text": " Bản tiên nói tốc độ tăng chậm lại còn khách đang chờ giá hạ xuống."
    },
    {
      "start": 26.72,
      "end": 27.82,
      "text": " Hai việc ấy khác nhau?"
    },
    {
      "start": 28.699999999999996,
      "end": 34.22,
      "text": " Một ổ bánh không đại diện cho làm phát cả nước. Chị số chung nhìn một rỗ nhiều hàn hóa và dịch vụ."
    },
    {
      "start": 35.02,
      "end": 40.7,
      "text": " Chiếc bánh ở đây chỉ giúp ta thấy phép tính, mức tăng mới có thể nhỏ nhưng nó cộng lên phần giá đã tăng từ trước."
    },
    {
      "start": 41.42,
      "end": 47.8,
      "text": " Vì thế, chị Hành không thể nghe 1 tỷ lệ làm pháp thấp hơn rồi từ suy ra bao bột, tiền thuê và tiền điện của mình đã về giá cũ."
    },
    {
      "start": 48.66,
      "end": 50.92,
      "text": " Nhưng nấu có một hóá đơn thực sự giảm thì sao?"
    },
    {
      "start": 51.84,
      "end": 57.0,
      "text": " Chẳng hạn, bột mua cho mẹ bánh mới đã rẻ hơn. Lúc ấy khách có được chờ bánh rẻ lại không?"
    },
    {
      "start": 57.0,
      "end": 57.86,
      "text": " Hãy subscribe cho kênh Ghiền Mì Gõ Để không bỏ lỡ những video hấp dẫn"
    }
  ],
