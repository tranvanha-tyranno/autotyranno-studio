        "text": "AI có thể hỗ trợ bản nháp."
      },
      {
        "start": 34.653,
        "end": 36.96,
        "text": "Nhưng bản nháp chưa phải kết quả cuối cùng."
      },
      {
        "start": 37.06,
        "end": 39.76,
        "text": "Một câu nghe trơn tru vẫn có thể thiếu bối"
      },
      {
        "start": 39.808,
        "end": 40.08,
        "text": "cảnh."
      },
      {
        "start": 40.22,
