[
  {
    "start": 0.0,
    "end": 2.2457280578429404,
    "text": "Một nghìn tỷ đô la xuất nhập khẩu."
  },
  {
    "start": 2.3097609961839725,
    "end": 6.010102430206868,
    "text": "Nghe như Việt Nam vừa kiếm được một gia tài. Nhưng khoan:"
  },
  {
    "start": 6.010102430206868,
    "end": 7.441952199236795,
    "text": "đó không phải lợi nhuận."
  },
  {
    "start": 7.45973086965254,
    "end": 10.471178951596706,
    "text": "Báo cáo mười tháng năm hai nghìn không trăm hai mươi sáu"
  },
  {
    "start": 10.471178951596706,
    "end": 12.874368347057642,
    "text": "ghi nhận thương mại hàng hóa vượt mốc này."
  },
  {
    "start": 12.911829684675636,
    "end": 16.259787105844545,
    "text": "Con số cộng cả hàng bán ra lẫn hàng mua vào."
  },
  {
    "start": 16.29724844346254,
    "end": 18.14741916047399,
    "text": "Hãy hình dung một xưởng may:"
  },
  {
    "start": 18.14741916047399,
    "end": 21.060453906406906,
    "text": "đơn hàng rất lớn, nhưng vải, máy móc và"
  },
  {
    "start": 21.060453906406906,
    "end": 22.55824061056437,
    "text": "thiết kế đều phải mua."
  },
  {
    "start": 22.595701948182366,
    "end": 26.258582044587264,
    "text": "Doanh thu chạy qua xưởng không đồng nghĩa tiền ở lại trong túi."
  },
  {
    "start": 26.31572604940751,
    "end": 28.201325567383005,
    "text": "Với nền kinh tế cũng vậy."
  },
  {
    "start": 28.201325567383005,
    "end": 32.0059208676441,
    "text": "Điều đáng hỏi là doanh nghiệp Việt giữ được bao nhiêu giá trị?"
  },
  {
    "start": 32.09554127334806,
    "end": 35.07451295440851,
    "text": "Muốn tiến xa, không chỉ cần thêm đơn hàng."
  },
  {
    "start": 35.07451295440851,
    "end": 37.98754770034143,
    "text": "Còn cần công nghệ, thiết kế, thương hiệu và"
  },
  {
    "start": 37.98754770034143,
    "end": 39.64279574211688,
    "text": "những doanh nghiệp nội đủ mạnh."
  },
  {
    "start": 39.837718417352875,
    "end": 41.95655754167503,
    "text": "Mốc kỷ lục là tín hiệu tích cực."
  },
  {
    "start": 41.95655754167503,
    "end": 44.99648122112873,
    "text": "Nhưng thước đo dài hạn vẫn là năng suất và thu nhập."
  },
  {
    "start": 45.002450291223134,
    "end": 48.0060253062864,
    "text": "Việt Nam sẽ chỉ bán nhiều hơn, hay sẽ làm"
  },
  {
    "start": 48.0060253062864,
    "end": 49.09047599919662,
    "text": "chủ nhiều hơn?"
  }
]