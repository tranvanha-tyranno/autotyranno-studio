{
  "plan": {
    "fps": 30,
    "durationFrames": 2333,
    "title": "Lương tăng, tiền dư đi đâu?",
    "segments": [
      {
        "id": "s01",
        "from": 0,
        "duration": 203,
        "text": "Lương tăng hai triệu, mà tiền dư chẳng tăng. Minh vừa vui được một tháng, đã thấy ví mình trở về chỗ cũ.",
        "kind": "main",
        "speaker": "minh",
        "visual": "hook",
        "speechStart": 0,
        "speechEnd": 185,
        "charStart": 0,
        "charEnd": 104
      },
      {
        "id": "s02",
        "from": 203,
        "duration": 148,
        "text": "Đây là tình huống giả định để học cách lập ngân sách, không phải tư vấn tài chính cá nhân.",
        "kind": "disclaimer",
        "speaker": "narrator",
        "visual": "disclaimer",
        "speechStart": 203,
        "speechEnd": 340,
        "charStart": 106,
        "charEnd": 196
      },
      {
        "id": "s03",
        "from": 351,
        "duration": 280,
        "text": "Lan hỏi: trước đây cậu chia tiền thế nào? Minh tính: lương mười hai triệu, chi mười triệu, còn hai triệu mỗi tháng.",
        "kind": "main",
        "speaker": "lan",
        "visual": "before",
        "speechStart": 351,
        "speechEnd": 623,
        "charStart": 198,
        "charEnd": 313
      },
      {
        "id": "s04",
        "from": 631,
        "duration": 259,
        "text": "Khi lương lên mười bốn triệu, Minh cũng chi tới mười hai triệu. Tiền dư vẫn chỉ hai triệu. Phần tăng thêm đã đi hết vào chi tiêu.",
        "kind": "main",
        "speaker": "minh",
        "visual": "after",
        "speechStart": 631,
        "speechEnd": 884,
        "charStart": 315,
        "charEnd": 444
      },
      {
        "id": "s05",
        "from": 890,
        "duration": 298,
        "text": "Minh thắc mắc: mình có mua gì lớn đâu? Lan chỉ ra: nếu mỗi ngày chi thêm sáu mươi nghìn, trong ba mươi ngày đã là một triệu tám.",
        "kind": "main",
        "speaker": "minh",
        "visual": "daily",
        "speechStart": 890,
        "speechEnd": 1179,
        "charStart": 446,
        "charEnd": 574
      },
      {
        "id": "s06",
        "from": 1188,
        "duration": 237,
        "text": "Thêm một bữa ăn hai trăm nghìn, tổng chi tăng đúng hai triệu. Mỗi lần thấy nhỏ, nhưng cộng lại vừa hết phần tăng lương.",
        "kind": "main",
        "speaker": "lan",
        "visual": "dinner",
        "speechStart": 1188,
        "speechEnd": 1417,
        "charStart": 576,
        "charEnd": 695
      },
      {
        "id": "s07",
        "from": 1425,
        "duration": 259,
        "text": "Nếu vẫn giữ được mức chi mười triệu, phần dư có thể là bốn triệu. Nhưng chi phí thiết yếu tăng thì phải tính lại, đừng ép mình theo con số này.",
        "kind": "main",
        "speaker": "narrator",
        "visual": "choice",
        "speechStart": 1425,
        "speechEnd": 1673,
        "charStart": 697,
        "charEnd": 840
      },
      {
        "id": "s08",
        "from": 1684,
        "duration": 317,
        "text": "Lan gợi ý: khi lương về, hãy dành trước một khoản phù hợp, sau khi tính tiền nhà, sinh hoạt và nghĩa vụ nợ. Có thể dùng chuyển khoản tự động để đỡ quên.",
        "kind": "main",
        "speaker": "lan",
        "visual": "transfer",
        "speechStart": 1684,
        "speechEnd": 1994,
        "charStart": 842,
        "charEnd": 994
      },
      {
        "id": "s09",
        "from": 2001,
        "duration": 332,
        "text": "Minh quyết định xem lại một khoản chi tăng gần đây. Bạn thử chọn một khoản của mình, cộng đủ cả tháng, rồi quyết định giữ hay giảm. Bắt đầu từ một khoản thôi.",
        "kind": "main",
        "speaker": "minh",
        "visual": "cta",
        "speechStart": 2001,
        "speechEnd": 2309,
        "charStart": 996,
        "charEnd": 1154
      }
    ],
