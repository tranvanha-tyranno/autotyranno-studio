  "captions": [
    {
      "start": 0.0,
      "end": 1.92,
      "text": "Một nghề không biến mất chỉ vì một thao tác"
    },
    {
      "start": 1.968,
      "end": 2.88,
      "text": "được làm nhanh hơn."
    },
    {
      "start": 2.973,
      "end": 5.68,
      "text": "Nhưng một người cũng khó yên tâm nếu phần"
    },
    {
      "start": 5.712,
      "end": 7.96,
      "text": "việc mình làm hằng ngày đang đổi khác."
    },
    {
      "start": 8.07,
      "end": 10.32,
      "text": "Vậy rốt cuộc, chúng ta nên nhìn vào tên"
    },
    {
      "start": 10.368,
      "end": 12.4,
      "text": "nghề, hay nhìn vào từng việc mình thực sự"
    },
    {
      "start": 12.46,
      "end": 12.8,
      "text": "làm?"
    },
    {
      "start": 13.328,
      "end": 15.92,
      "text": "Phần sau là một cách tự rà soát công việc,"
    },
    {
      "start": 15.947,
      "end": 17.68,
      "text": "không phải kết luận về tương lai của mọi"
    },
    {
      "start": 17.728,
      "end": 18.0,
      "text": "nghề."
    },
    {
      "start": 18.65,
      "end": 20.48,
      "text": "Hãy lấy một ngày làm việc bình thường."
    },
    {
      "start": 20.66,
      "end": 23.44,
      "text": "Bạn tìm thông tin, viết bản đầu, kiểm"
    },
    {
      "start": 23.5,
      "end": 25.76,
      "text": "tra, trao đổi và đưa ra quyết định."
    },
    {
      "start": 25.88,
      "end": 28.48,
      "text": "Những việc ấy nằm chung trong một chức danh,"
    },
    {
      "start": 28.533,
      "end": 30.4,
      "text": "nhưng không có cùng mức độ cần con người."
    },
    {
      "start": 30.667,
      "end": 32.96,
      "text": "Vì vậy, thay vì hỏi máy có thay mình"
    },
    {
      "start": 33.013,
      "end": 34.24,
      "text": "không, thử hỏi:"
    },
    {
      "start": 34.32,
      "end": 36.72,
      "text": "phần nào có thể tạo nháp, phần nào phải đối"
    },
    {
      "start": 36.773,
      "end": 38.96,
      "text": "chiếu, và phần nào cần mình chịu trách"
    },
    {
      "start": 38.987,
      "end": 39.2,
      "text": "nhiệm?"
    },
    {
      "start": 39.44,
      "end": 41.92,
      "text": "Bạn có thể nhờ công cụ gợi ý cấu trúc."
    },
    {
      "start": 42.0,
      "end": 44.48,
      "text": "Nhưng khi một con số không khớp, bạn cần"
    },
    {
      "start": 44.512,
      "end": 45.2,
      "text": "quay về nguồn."
    },
    {
      "start": 45.44,
      "end": 48.16,
      "text": "Khi khách hàng đang bức xúc, một câu trả"
    },
    {
      "start": 48.2,
      "end": 50.24,
      "text": "lời lịch sự chưa chắc đã giải quyết đúng vấn"
    },
    {
      "start": 50.32,
      "end": 50.56,
      "text": "đề."
    },
    {
      "start": 50.74,
      "end": 52.4,
      "text": "Đây là điểm cần phân biệt:"
    },
    {
      "start": 52.52,
      "end": 55.12,
      "text": "đầu ra trông có vẻ hoàn chỉnh, và một công"
    },
    {
      "start": 55.184,
      "end": 56.96,
      "text": "việc thật sự được hoàn thành."
    },
    {
      "start": 57.08,
      "end": 59.52,
      "text": "Khoảng cách giữa hai điều đó chính là chỗ để"
    },
    {
      "start": 59.568,
      "end": 61.84,
      "text": "kiểm tra, hiểu bối cảnh và quyết định."
    },
    {
      "start": 62.24,
      "end": 64.32,
      "text": "Hôm nay, hãy chọn một nhiệm vụ."
    },
    {
      "start": 64.507,
      "end": 67.2,
      "text": "Viết rõ tiêu chuẩn đạt, thử bằng dữ liệu giả"
    },
    {
      "start": 67.232,
      "end": 68.96,
      "text": "định, rồi tự so kết quả."
    },
    {
      "start": 69.227,
      "end": 70.64,
      "text": "Đo cả thời gian sửa."
    },
    {
      "start": 70.78,
      "end": 73.2,
      "text": "Chỉ giữ cách làm khi bạn kiểm soát được chất"
    },
    {
      "start": 73.24,
      "end": 73.52,
      "text": "lượng."
    },
    {
      "start": 74.07,
      "end": 76.0,
      "text": "Bạn muốn bóc tách nhiệm vụ nào tiếp theo?"
    },
    {
      "start": 76.18,
      "end": 78.8,
      "text": "Hãy để lại một ví dụ dưới bình luận, và"
    },
    {
      "start": 78.848,
      "end": 81.2,
      "text": "đăng ký TYRANNO để cùng quan sát công việc"
    },
    {
      "start": 81.232,
      "end": 81.84,
      "text": "đang thay đổi."
    }
  ]
